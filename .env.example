# -----------------------------------------------------------------------------
# InfoSnack local environment
# Copy this file to .env and change secrets before running Docker Compose or apps.
# -----------------------------------------------------------------------------

# App URLs
APP_ENV=local
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8001
FRONTEND_PORT=3000
BACKEND_PORT=8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# PostgreSQL 16 + pgvector
POSTGRES_USER=infosnack
POSTGRES_PASSWORD=infosnack
POSTGRES_DB=infosnack
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://infosnack:infosnack@localhost:5432/infosnack

# Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=infosnack
MINIO_ROOT_PASSWORD=infosnack-local-secret
MINIO_BUCKET=infosnack-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=infosnack-local
S3_ACCESS_KEY_ID=infosnack
S3_SECRET_ACCESS_KEY=infosnack-local-secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Auth / credential encryption
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
# Format: key-id:base64-32-byte-key. Generate value with: openssl rand -base64 32
ENCRYPTION_KEYS=local-v1:change-me-generate-with-openssl-rand-base64-32

# AI gateway / OpenRouter
AI_GATEWAY_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_INPUT_MODEL=anthropic/claude-sonnet-latest
OPENROUTER_IMAGE_INPUT_MODEL=anthropic/claude-sonnet-latest
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-latest
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_RERANK_MODEL=cohere/rerank-4-fast

# OCR / Upstage
UPSTAGE_API_KEY=
UPSTAGE_OCR_ENDPOINT=https://console.upstage.ai/api/parse/document-ocr

# Optional source credentials
# Prefer saving these as encrypted credentials in the app once backend exists.
GITHUB_TOKEN=
HF_TOKEN=

# Local E2E seed user. Production must ignore this block.
E2E_SEED_USER_ENABLED=true
E2E_USER_EMAIL=playwright-e2e@infosnack.dev
E2E_USER_PASSWORD=correct horse battery staple 42
E2E_USER_NAME=E2E User
